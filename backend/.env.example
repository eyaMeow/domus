PORT=4000
# Local development database and photo storage:
DATABASE_PATH=./data/domus.sqlite
UPLOADS_PATH=./data/uploads
DOMUS_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=*
# Production only: set NODE_ENV=production and configure Supabase, HTTPS CORS,
# an admin account, and SMTP directly in the hosting dashboard.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-photos
DOMUS_ADMIN_EMAIL=
DOMUS_ADMIN_PASSWORD=
NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set either the JSON value or a path to a mounted service-account file.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Example: FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
